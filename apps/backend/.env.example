NODE_ENV=development
PORT=9000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/property-command-center
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=false

# Production must use unique 64+ character JWT secrets, HTTPS WEB_ORIGIN,
# REFRESH_COOKIE_SECURE=true, and a non-local MongoDB replica set/cluster.

# Safaricom Daraja / M-Pesa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/v1/integrations/webhooks/MPESA
# Optional only when the deployed M-Pesa callback gateway adds an HMAC signature.
MPESA_WEBHOOK_SECRET=

# Paystack. The secret key also verifies x-paystack-signature webhook headers.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://app.example.com/finance

# Existing Stripe payment/subscription integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional messaging. Twilio is required for production OTP delivery;
# SendGrid is required for production email notifications.
SMS_PROVIDER=TWILIO
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_PROVIDER=SENDGRID
EMAIL_FROM=
SENDGRID_API_KEY=

# Optional WhatsApp Cloud notifications (configure both or neither).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Production evidence/document storage.
S3_BUCKET=
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for an S3-compatible provider; leave blank for AWS S3.
S3_ENDPOINT=

# Browser-compatible CCTV streaming gateway. Never place RTSP credentials here.
CCTV_PROVIDER_BASE_URL=
CCTV_PROVIDER_API_KEY=
# Optional NVR HTTP adapter (configure both or neither).
NVR_BASE_URL=
NVR_API_KEY=
