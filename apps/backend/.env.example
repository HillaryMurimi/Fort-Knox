NODE_ENV=development
# Optional review scope: development, test, staging or production. Defaults to NODE_ENV.
LAUNCH_READINESS_ENV=
PORT=9000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:9000
# Optional social owner sign-in. Register the matching /api/v1/auth/social/{provider}/callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017/property-command-center
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=false

# Production must use unique 64+ character JWT secrets, HTTPS WEB_ORIGIN,
# REFRESH_COOKIE_SECURE=true, and a non-local MongoDB replica set/cluster.

# Safaricom Daraja / M-Pesa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/v1/integrations/webhooks/MPESA
# Optional only when the deployed M-Pesa callback gateway adds an HMAC signature.
MPESA_WEBHOOK_SECRET=

# Paystack. Supply sk_test_... for staging and sk_live_... for production.
# Register https://YOUR_API_HOST/api/v1/integrations/webhooks/PAYSTACK in Paystack.
# Recurring subscriptions require card checkout; rent checkout has additional methods.
# WEB_ORIGIN must match the frontend origin for the billing return page.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://app.example.com/finance

# Transactional messaging. Twilio is required for production OTP delivery;
# SendGrid is required for production email notifications.
SMS_PROVIDER=TWILIO
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_PROVIDER=SENDGRID
EMAIL_FROM=
SENDGRID_API_KEY=

# Optional WhatsApp Cloud notifications (configure both or neither).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Production evidence/document storage.
S3_BUCKET=
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for an S3-compatible provider; leave blank for AWS S3.
S3_ENDPOINT=

# Browser-compatible CCTV streaming gateway. Never place RTSP credentials here.
CCTV_PROVIDER_BASE_URL=
CCTV_PROVIDER_API_KEY=
# Optional NVR HTTP adapter (configure both or neither).
NVR_BASE_URL=
NVR_API_KEY=


# Platform monitoring thresholds (seconds or event counts; no secrets).
MONITORING_QUEUE_AGE_SECONDS=900
MONITORING_ONBOARDING_AGE_SECONDS=86400
MONITORING_HEARTBEAT_STALE_SECONDS=120
MONITORING_AUTH_BURST_THRESHOLD=20
MONITORING_DENIAL_THRESHOLD=5

# Role-based SUPER_ADMIN MFA policy (bounded defaults; no identity bypass)
ADMIN_OTP_TTL_SECONDS=180
ADMIN_FLOW_SECONDS=900
ADMIN_RESEND_SECONDS=60
ADMIN_VERIFY_SECONDS=2
ADMIN_MAX_RESENDS=3
ADMIN_MAX_SENDS=10
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_SESSION_SECONDS=1800
ADMIN_IDLE_SECONDS=300
ADMIN_STEP_UP_SECONDS=300
# Runtime destinations come from the existing User, not bootstrap env values.
# Configure existing SendGrid/Twilio secret variables outside Git; see
# docs/SUPER_ADMIN_AUTHENTICATION.md before deployment/enrollment.

# Initial guided pilot duration; server validated, never commercial activation.
GUIDED_PILOT_DAYS=14
